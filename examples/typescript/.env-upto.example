# TRON upto: copy to .env-upto and configure your wallet and payout address.
# Loaded by the corresponding client, server, and facilitator.
# Configure agent-wallet through its provider settings or local raw-secret environment.
AGENT_WALLET_PRIVATE_KEY=0x...
TRON_GRID_API_KEY=
TRON_ADDRESS=T...
# Nile by default; mainnet uses real funds.
TRON_NETWORK=tron:3448148188
PAY_TARGETS=tron:3448148188@USDT
RESOURCE_URL=http://localhost:4051/generate
SERVER_PORT=4051
FACILITATOR_PORT=4052
FACILITATOR_URL=http://localhost:4052
NUMBER_OF_REQUESTS=3
MAX_PRICE=$0.10

# Optional hosted facilitator authentication. Never commit a real key.
# FACILITATOR_API_KEY=
# Optional localhost URL compatibility for a hosted facilitator's edge WAF.
# STRIP_RESOURCE_URL=true
