# ── Scenario: batch-settlement (payment channels, EVM + TRON) ──────────────
# Copy to `.env-batch` (gitignored); the batch trio loads it:
#   clients/batch-settlement · servers/batch-settlement · facilitator/batch-settlement
#
#   cp .env-batch.example .env-batch
#
# The payer deposits once on-chain, then pays many requests with off-chain
# vouchers; the server's channel manager claims a batch and settles to payTo.
#
# One file, three processes. Vars grouped by the process that reads them:
# SHARED (client + facilitator), CLIENT (payer), SERVER (resource provider),
# FACILITATOR (settlement).

# ── SHARED · client + facilitator ─────────────────────────────────────────
# Signing key — payer (client) and settler (facilitator), both chains.
AGENT_WALLET_PRIVATE_KEY=0x...

# TronGrid API key — both client and facilitator touch TRON. Optional.
TRON_GRID_API_KEY=

# ── CLIENT · the payer (clients/batch-settlement) ─────────────────────────
# Which chains to exercise, one burst (+refund) per entry, in order. Each entry is
#   <network>[@<token>]  network: CAIP-2 chain id —
#     EVM:  "eip155:97" (BSC testnet), "eip155:56" (BSC mainnet)
#     TRON: "tron:0xcd8690dc" (Nile testnet), "tron:0x94a9059e" (Shasta testnet), "tron:0x2b6653dc" (mainnet)
#     Shortcuts: "eip155" or "tron" match any network of that family.
#   token optional (each chain advertises one: EVM=USDC, TRON=USDT) — symbol or
#   asset address. Use `@` (not `#`) — dotenv treats `#` as a comment.
# Unset ⇒ each configured chain once.
PAY_TARGETS=eip155:97,tron:0xcd8690dc

# The resource the client fetches (server route).
RESOURCE_URL=http://localhost:4041/weather

# Burst behaviour.
NUMBER_OF_REQUESTS=3        # 1 deposit + N-1 vouchers (per target)
DEPOSIT_MULTIPLIER=5        # deposit this many requests' worth when (re)opening
REFUND_AFTER_REQUESTS=false # refund the remaining channel balance after the burst
# REFUND_AMOUNT=            # base units; omit for a full refund
# CHANNEL_SALT=0x...        # 32-byte hex; omit for the zero salt

# Optional EVM RPC override. viem's default BSC testnet node
# (data-seed-prebsc-*.bnbchain.org:8545) is often unreachable; batch-settlement
# reads the chain (channel state, allowance), so set a reliable endpoint if the
# EVM run fails.
# EVM_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# ── SERVER · the resource provider (servers/batch-settlement) ─────────────
# Payout addresses (set the chain(s) you want to accept).
EVM_ADDRESS=0x...   # BSC, eip155:97 (token USDC, permit2)
TRON_ADDRESS=T...   # TRON Nile (tron:0xcd8690dc); Shasta: tron:0x94a9059e; mainnet: tron:0x2b6653dc (token USDT, permit2)
# TRON network: tron:0xcd8690dc (Nile, default), tron:0x94a9059e (Shasta), tron:0x2b6653dc (mainnet)
# TRON_NETWORK=tron:0xcd8690dc

# Where the server binds, and where it reaches the facilitator.
SERVER_PORT=4041
FACILITATOR_URL=http://localhost:4042

# Optional: drop `paymentPayload.resource` (a localhost URL when the server runs
# locally) before verify/settle. Set "true" only when a LOCAL server points at a
# hosted facilitator whose edge WAF rejects loopback URLs in the body (e.g. AWS
# `EC2MetaDataSSRF_BODY` -> 403). Facilitator never reads it; signature ignores it.
# STRIP_RESOURCE_URL=true

# Optional: facilitator API key, sent as the `X-API-KEY` header on every
# verify/settle/supported call the SERVER makes. Hosted facilitators use it to
# select a rate-limit tier — anonymous calls still work, so leave it unset for
# local runs.
# FACILITATOR_API_KEY=your-key-here

# ── FACILITATOR · settlement (facilitator/batch-settlement) ───────────────
# Where the facilitator binds (FACILITATOR_URL above must point here).
FACILITATOR_PORT=4042
