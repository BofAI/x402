# ── Scenario: main line (scheme `exact`) ──────────────────────────────────
# Copy to `.env-exact` (gitignored); the exact trio loads it:
#   clients/fetch · servers/express · facilitator/basic
#
#   cp .env-exact.example .env-exact
#
# One file, three processes. Each var below is grouped by the process that
# reads it: SHARED (client + facilitator), CLIENT (payer), SERVER (resource
# provider), FACILITATOR (settlement). The server never signs — it only holds
# payout addresses and calls the facilitator.

# ── SHARED · client + facilitator ─────────────────────────────────────────
# Signing key — the payer (client) and the settler (facilitator) use the same
# key here, on both chains.
AGENT_WALLET_PRIVATE_KEY=0x...

# TronGrid API key — both the client and the facilitator touch TRON. Optional.
TRON_GRID_API_KEY=

# Optional EVM RPC override used by both client and facilitator. It must match
# the EVM network selected in PAY_TARGETS. For BSC mainnet use
# https://bsc-rpc.publicnode.com. Mainnet uses REAL FUNDS.
# EVM_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# ── CLIENT · the payer (clients/fetch · clients/mcp) ──────────────────────
# Which chains/tokens to pay, one payment per entry, in order.
#   <network>[@<token>]  network: CAIP-2 chain id —
#     EVM:  "eip155:97" (BSC testnet), "eip155:56" (BSC mainnet)
#     TRON: "tron:3448148188" (Nile testnet), "tron:2494104990" (Shasta testnet), "tron:728126428" (mainnet)
#     Shortcuts: "eip155" or "tron" match any network of that family.
#   token: symbol (DHLU/USDC/USDT on EVM, USDT/USDD on TRON) or an asset address;
#   omit the token to use that network's first advertised token.
#   Use `@` (not `#`) — dotenv treats `#` as a comment and would truncate the value.
# Unset ⇒ each configured chain once, with its first token.
PAY_TARGETS=eip155:97@DHLU,tron:3448148188@USDT

# The resource the client fetches (server route).
RESOURCE_URL=http://localhost:4021/weather

# MCP client (clients/mcp) — where to reach the MCP server.
MCP_SERVER_URL=http://localhost:4023

# ── SERVER · the resource provider (servers/express · servers/mcp) ────────
# Payout addresses (set the chain(s) you want to accept).
EVM_ADDRESS=0x...   # BSC, eip155:97
TRON_ADDRESS=T...   # TRON Nile (tron:3448148188); Shasta: tron:2494104990; mainnet: tron:728126428

# Where the server binds, and where it reaches the facilitator.
SERVER_PORT=4021
FACILITATOR_URL=http://localhost:4022

# MCP server (servers/mcp) — port it binds.
MCP_SERVER_PORT=4023

# Optional: drop `paymentPayload.resource` (a localhost URL when the server runs
# locally) before the server calls verify/settle. Set "true" only when pointing a
# LOCAL server at a hosted facilitator whose edge WAF rejects loopback URLs in the
# request body (e.g. AWS `EC2MetaDataSSRF_BODY` → 403). The facilitator never reads
# this field and the signature doesn't cover it, so stripping is a functional no-op.
# STRIP_RESOURCE_URL=true

# Optional: facilitator API key, sent as the `X-API-KEY` header on every
# verify/settle/supported call the SERVER makes. Hosted facilitators use it to
# select a rate-limit tier — anonymous calls still work, so leave it unset for
# local runs.
# FACILITATOR_API_KEY=your-key-here

# ── FACILITATOR · settlement (facilitator/basic) ──────────────────────────
# Where the facilitator binds (FACILITATOR_URL above must point here).
FACILITATOR_PORT=4022
