# ── Scenario: TRON Approval Resource Sponsoring (Nile) ────────────────
# Copy to `.env-tron-sponsoring` (gitignored); the client, server, and
# facilitator all load this file:
#
#   cp .env-tron-sponsoring.example .env-tron-sponsoring
#
# The payer and Resource Owner MUST use different agent-wallet entries. This
# file selects wallet IDs but never contains either private key. The payer signs
# the TRC-20 Approval; the Resource Owner delegates and reclaims resources.

# ── SHARED ─────────────────────────────────────────────────────────
TRON_GRID_API_KEY=
TRON_NILE_RPC_URL=https://api.nileex.io

# ── CLIENT · payer ──────────────────────────────────────────────────
TRON_SPONSORING_CLIENT_WALLET_ID=tron-sponsoring-payer
RESOURCE_URL=http://localhost:4041/weather

# ── SERVER · resource provider ──────────────────────────────────────
TRON_ADDRESS=T...
FACILITATOR_URL=http://localhost:4042
SERVER_PORT=4041

# ── FACILITATOR · settlement and Resource Owner ─────────────────────
TRON_SPONSORING_RESOURCE_OWNER_WALLET_ID=tron-resource-owner
TRON_PERMISSION_ID=2
FACILITATOR_PORT=4042

# Optional operational tuning; defaults shown.
TRON_SPONSORING_ASSET=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
TRON_SPONSORING_RECOVERY_INTERVAL_MS=15000
TRON_SPONSORING_ENERGY_STAKE_SUN_CAPACITY=2000000000
TRON_SPONSORING_BANDWIDTH_STAKE_SUN_CAPACITY=2000000000
TRON_SPONSORING_BUDGET_CAPACITY=100000000
TRON_SPONSORING_MANAGEMENT_BANDWIDTH_CAPACITY=10000
