# TRON Nile e2e credentials.
# Copy to the package root as `.env` (packages/mechanisms/tron/.env) — gitignored,
# loaded automatically by vitest's loadEnv. Without these, the e2e suite skips.

# Payer (buyer) — funded with Nile USDT; for `exact` also needs a one-time
# Permit2 approval; for `exact_gasfree` needs an activated + funded GasFree account.
PAYER_PRIVATE_KEY=

# Facilitator — pays energy/TRX for `exact`/permit2 on-chain settlement.
FACILITATOR_PRIVATE_KEY=

# Payment recipient (Base58Check, T...).
PAY_TO=

# Optional: TronGrid API key (raises rate limits / avoids throttling).
TRON_GRID_API_KEY=

# Optional: override the GasFree relayer base URL (defaults to open-test.gasfree.io/nile).
GASFREE_API_URL=
