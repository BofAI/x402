{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "cd .. && pnpm install && cd site && pnpm -r --filter=site... run build",
    "start": "next start",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.2.1",
    "@coinbase/cdp-sdk": "^1.22.0",
    "@heroicons/react": "^2.2.0",
    "@scure/base": "^1.2.6",
    "@solana/kit": "^6.1.0",
    "@vercel/functions": "^2.2.8",
    "@bankofai/x402-aptos": "workspace:*",
    "@bankofai/x402-avm": "workspace:*",
    "@bankofai/x402-core": "workspace:*",
    "@bankofai/x402-evm": "workspace:*",
    "@bankofai/x402-extensions": "workspace:*",
    "@bankofai/x402-hedera": "workspace:*",
    "@bankofai/x402-next": "workspace:*",
    "@bankofai/x402-paywall": "workspace:*",
    "@bankofai/x402-stellar": "workspace:*",
    "@bankofai/x402-svm": "workspace:*",
