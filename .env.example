# x402 e2e testnet environment
#
# Copy to `.env` and fill in real values before running the testnet suite:
#
#     cp .env.example .env
#     set -a; source .env; set +a
#     ./e2e/scenarios/run_testnet.sh
#
# When a variable is left blank, the corresponding testnet scenario is SKIPPED
# (the mock suite under e2e/scenarios/ always runs regardless).
#
# .env is git-ignored — never commit real keys. In CI use GitHub Secrets.

# ---------------------------------------------------------------------------
# Common
# ---------------------------------------------------------------------------

# URL of the facilitator started by examples.facilitator (change if you point
# at an externally hosted facilitator).
FACILITATOR_URL=http://127.0.0.1:8013

# ---------------------------------------------------------------------------
# BSC testnet (eip155:97) — used by exact_testnet / exact_permit_testnet
# ---------------------------------------------------------------------------

# Optional RPC override; if unset the SDK default in NetworkConfig is used.
BSC_TESTNET_RPC_URL=

# Payer wallet (needs BNB for gas + test token balance).
BSC_TESTNET_CLIENT_KEY=

# Facilitator wallet (signs settlement txs — needs BNB for gas).
BSC_TESTNET_FACILITATOR_KEY=

# Resource server's payout address.
BSC_TESTNET_PAY_TO=

# Price spec for the `exact` scenario. Must reference a token that's in
# TokenRegistry for eip155:97 AND supports ERC-3009 transferWithAuthorization.
# Known good: DHLU (validated 2026-04-03 via examples/bsc-testnet-smoke).
BSC_TESTNET_EXACT_PRICE=0.0001 DHLU

# Price spec for the `exact_permit` scenario. Must reference a token in
# TokenRegistry for eip155:97 AND supporting EIP-2612 permit.
BSC_TESTNET_PERMIT_PRICE=0.0001 USDT

# ---------------------------------------------------------------------------
# TRON Nile testnet (tron:nile) — used by exact_gasfree_testnet
# ---------------------------------------------------------------------------

# Optional RPC override (TronGrid Nile). If blank, the SDK default is used.
TRON_NILE_RPC_URL=

# Payer wallet — 0x-prefixed hex. Payer holds tokens in their GasFree
# custodial wallet, NOT the main wallet (see exact-gasfree spec).
TRON_NILE_CLIENT_KEY=

# Facilitator wallet — 0x-prefixed hex. Relayer that submits the GasFree tx
# and pays TRX for gas.
TRON_NILE_FACILITATOR_KEY=

# Resource server's payout address (base58, starts with T...).
TRON_NILE_PAY_TO=

# Real GasFree API endpoint for Nile. Ask the GasFree team for the testnet
# URL; the mock served by e2e/mock_facilitator is NOT suitable here.
GASFREE_NILE_API_URL=

# Price spec for the GasFree scenario. Must reference a TRC-20 token in
# TokenRegistry for tron:nile.
TRON_NILE_GASFREE_PRICE=0.0001 USDT
