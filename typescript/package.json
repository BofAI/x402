{
  "name": "@bankofai/x402-typescript",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.7.0"
  },
  "packageManager": "pnpm@10.7.0",
  "private": "true",
  "version": "0.0.2",
  "description": "x402 Payment Protocol Monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/BofAI/x402.git",
    "directory": "typescript"
  },
  "main": "index.js",
  "pnpm": {
    "overrides": {
      "cssstyle": "5.3.6"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "lint:check": "turbo run lint:check",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @bankofai/x402-core --filter @bankofai/x402-evm --filter @bankofai/x402-svm --filter @bankofai/x402-aptos test:integration",
    "test:all": "pnpm test && pnpm test:integration"
  },
  "keywords": [],
  "author": "bankofai",
  "license": "ISC",
  "devDependencies": {
    "tsup": "^8.4.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "@changesets/cli": "^2.28.1",
    "@changesets/changelog-github": "^0.5.1"
  }
}
