{
  "name": "@bankofai/x402-mcp",
  "version": "2.6.0-beta.9",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --dir test/integration",
    "test:watch": "vitest",
    "build": "tsup",
    "cli": "node ./bin/x402.js",
    "watch": "tsc --watch",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "author": "bankofai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BofAI/x402.git"
  },
  "description": "x402 Payment Protocol",
  "bin": {
    "x402": "bin/x402.js",
    "x402-mcp": "bin/x402-mcp.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.9",
    "eslint-plugin-prettier": "^5.2.6",
    "express": "^4.21.2",
    "prettier": "3.5.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5",
    "vite": "^6.2.6"
  },
  "dependencies": {
    "@bankofai/x402-core": "workspace:~",
    "@bankofai/x402-evm": "workspace:~",
    "@bankofai/x402-fetch": "workspace:~",
    "@bankofai/x402-tron": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "tronweb": "^6.0.0",
    "tsx": "^4.19.2",
    "viem": "^2.27.2",
    "zod": "^3.24.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "src/command"
  ]
}
