# Nile-only TRC-20 Approval Resource Sponsoring integration test.
# Copy to `.env` in this directory. Never use mainnet keys here.

TRON_NILE_RPC_URL=https://api.nileex.io
TRON_NILE_FACILITATOR_KEY=0x...
TRON_NILE_FACILITATOR_PERMISSION_ID=0
TRON_NILE_PAY_TO=T...

# Recommended for repeatable runs: create a fresh default-owner payer, activate
# it with 2 test TRX, and fund it with 1 test USDT from the Facilitator account.
# The Facilitator account therefore needs Nile USDT in addition to staked Energy
# and at least ~700 available management Bandwidth.
TRON_NILE_FRESH_PAYER=true

# Alternative: reuse a funded default-owner payer. A successful test leaves a
# MaxUint Permit2 allowance, so the setup resets it to zero before the measured
# sponsorship flow. The payer needs enough test TRX for that reset transaction.
# TRON_NILE_FRESH_PAYER=false
# TRON_NILE_CLIENT_KEY=0x...
