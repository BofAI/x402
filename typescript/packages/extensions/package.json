{
  "name": "@bankofai/x402-tron-extensions",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "version": "2.1.0-beta.1",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "start": "tsx --env-file=.env index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc --watch",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts",
    "test:consumer": "node test/consumer/verify-packed.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "keywords": [
    "x402",
    "payment",
    "protocol",
    "extensions"
  ],
  "license": "Apache-2.0",
  "author": "x402 Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BofAI/x402.git",
    "directory": "typescript/packages/extensions"
  },
  "description": "TRON resource-sponsoring extensions for official x402 Core",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.9",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "3.5.2",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5",
    "@x402/core": "2.28.0",
    "@bankofai/agent-wallet": "2.4.0"
  },
  "dependencies": {
    "@bankofai/x402-tron": "workspace:2.1.0-beta.1",
    "ajv": "^8.17.1",
    "tronweb": "6.3.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./trc20-approval-resource-sponsoring": {
      "import": {
        "types": "./dist/esm/trc20-approval-resource-sponsoring/index.d.mts",
        "default": "./dist/esm/trc20-approval-resource-sponsoring/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/trc20-approval-resource-sponsoring/index.d.ts",
        "default": "./dist/cjs/trc20-approval-resource-sponsoring/index.js"
      }
    },
    "./trc20-approval-resource-sponsoring/client": {
      "import": {
        "types": "./dist/esm/trc20-approval-resource-sponsoring/client.d.mts",
        "default": "./dist/esm/trc20-approval-resource-sponsoring/client.mjs"
      },
      "require": {
        "types": "./dist/cjs/trc20-approval-resource-sponsoring/client.d.ts",
        "default": "./dist/cjs/trc20-approval-resource-sponsoring/client.js"
      }
    },
    "./trc20-approval-resource-sponsoring/facilitator": {
      "import": {
        "types": "./dist/esm/trc20-approval-resource-sponsoring/facilitator.d.mts",
        "default": "./dist/esm/trc20-approval-resource-sponsoring/facilitator.mjs"
      },
      "require": {
        "types": "./dist/cjs/trc20-approval-resource-sponsoring/facilitator.d.ts",
        "default": "./dist/cjs/trc20-approval-resource-sponsoring/facilitator.js"
      }
    },
    "./trc20-approval-resource-sponsoring/resourceService": {
      "import": {
        "types": "./dist/esm/trc20-approval-resource-sponsoring/resourceService.d.mts",
        "default": "./dist/esm/trc20-approval-resource-sponsoring/resourceService.mjs"
      },
      "require": {
        "types": "./dist/cjs/trc20-approval-resource-sponsoring/resourceService.d.ts",
        "default": "./dist/cjs/trc20-approval-resource-sponsoring/resourceService.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@x402/core": "2.28.0"
  }
}
