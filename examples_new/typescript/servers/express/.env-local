# The resource server holds NO key — it only needs payout addresses (public) and
# the facilitator URL. Set the chain(s) you want to accept; the other self-skips.

# Payout addresses (where payments are sent):
EVM_ADDRESS=
TRON_ADDRESS=

# Facilitator that verifies/settles payments:
FACILITATOR_URL=http://localhost:4022

PORT=4021
