# ── Scenario: upto (usage-based billing, EVM + TRON) ───────────────────────
# Copy to `.env-upto` (gitignored); the upto trio loads it:
#   clients/upto · servers/upto · facilitator/upto
#
#   cp .env-upto.example .env-upto
#
# The payer signs an authorization for up to a MAXIMUM amount; the server
# decides the REAL usage per request and settles only that (<= max). The
# facilitator submits the on-chain settlement. Both chains use Permit2.

# Signing key — one key for client + facilitator, both chains.
AGENT_WALLET_PRIVATE_KEY=0x...

# Resource-server payout addresses (set the chain(s) you want to accept).
EVM_ADDRESS=0x...   # BSC, eip155:97 (token USDC, permit2)
TRON_ADDRESS=T...   # TRON, tron:nile (token USDT, permit2)

# Optional TronGrid API key.
TRON_GRID_API_KEY=

# Optional EVM RPC override (clients/upto). viem's default BSC testnet node
# (data-seed-prebsc-*.bnbchain.org:8545) is often unreachable; the upto/permit2
# path reads the chain, so set a reliable endpoint if the EVM run fails.
# EVM_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# App wiring — facilitator 4052, server 4051 (own ports, never clash).
FACILITATOR_PORT=4052
SERVER_PORT=4051
FACILITATOR_URL=http://localhost:4052
RESOURCE_URL=http://localhost:4051/generate

# Which chains to exercise, one N-request run per entry, in order. Each entry is
#   <network>[@<token>]  network: "eip155:97"/"tron:nile" (or "eip155"/"tron");
#   token optional (each chain advertises one: EVM=USDC, TRON=USDT) — symbol or
#   asset address. Use `@` (not `#`) — dotenv treats `#` as a comment.
# Unset ⇒ each configured chain once.
PAY_TARGETS=eip155:97,tron:nile

# Client behaviour.
NUMBER_OF_REQUESTS=3   # how many usage-billed requests to fire (per target)

# Server authorization ceiling (the "upto" max the client signs). Real charge
# per request is a random amount in [0, this], shown in each response.
MAX_PRICE=$0.10

# Optional: drop `paymentPayload.resource` (a localhost URL when the server runs
# locally) before verify/settle. Set "true" only when a LOCAL server points at a
# hosted facilitator whose edge WAF rejects loopback URLs in the body (e.g. AWS
# `EC2MetaDataSSRF_BODY` -> 403). Facilitator never reads it; signature ignores it.
# STRIP_RESOURCE_URL=true

# Optional: facilitator API key, sent as the `X-API-KEY` header on every
# verify/settle/supported call. Hosted facilitators use it to select a rate-limit
# tier — anonymous calls still work, so leave it unset for local runs.
# FACILITATOR_API_KEY=your-key-here
