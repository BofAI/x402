# Copy to `.env-local` (gitignored); all three apps load it.

# Signing key — one key for client + facilitator, both chains.
AGENT_WALLET_PRIVATE_KEY=0x...

# Optional split keys for real smoke / production-like setups.
# These take precedence over AGENT_WALLET_PRIVATE_KEY in the relevant process.
EVM_CLIENT_PRIVATE_KEY=0x...
EVM_FACILITATOR_PRIVATE_KEY=0x...
TRON_CLIENT_PRIVATE_KEY=0x...
TRON_FACILITATOR_PRIVATE_KEY=0x...

# Resource-server payout addresses (set the chain(s) you want to accept).
EVM_ADDRESS=0x...   # BSC, eip155:97
TRON_ADDRESS=T...   # TRON, tron:nile

# Optional custom EVM RPC.
EVM_RPC_URL=
BSC_TESTNET_RPC_URL=

# Optional TronGrid API key.
TRON_GRID_API_KEY=

# App wiring.
FACILITATOR_URL=http://localhost:4022
RESOURCE_URL=http://localhost:4021/weather
