# ── Copy the relevant block into each example's own .env-local ──
# Every example self-skips a chain whose vars are absent, so you can run
# EVM-only or TRON-only without supplying the other chain's credentials.

# ── EVM (Base Sepolia, eip155:84532) ───────────────────────────
# Client/facilitator signing key (0x-prefixed). Use separate keys per role.
EVM_PRIVATE_KEY=0x...
# Optional JSON-RPC endpoint; defaults to the chain's public RPC.
EVM_RPC_URL=
# Payment recipient address (resource server only).
EVM_ADDRESS=0x...

# ── TRON (Nile testnet, tron:nile) ─────────────────────────────
# Client/facilitator signing key (hex, with or without 0x).
TRON_PRIVATE_KEY=...
# Optional TronGrid API key (raises rate limits).
TRON_GRID_API_KEY=
# Payment recipient address (Base58Check, resource server only).
TRON_ADDRESS=T...

# ── Wiring between the three apps ──────────────────────────────
# Resource server → facilitator (server only).
FACILITATOR_URL=http://localhost:4022
# Client → resource server (client only).
RESOURCE_URL=http://localhost:4021/weather
