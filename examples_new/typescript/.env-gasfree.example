# ── Scenario: GasFree (scheme `exact_gasfree`, TRON-only) ──────────────────
# Copy to `.env-gasfree` (gitignored); the gasfree trio loads it:
#   clients/gasfree · servers/gasfree · facilitator/gasfree
#
#   cp .env-gasfree.example .env-gasfree
#
# TRON-only: the payer signs a TIP-712 GasFree permit and a relayer pays the
# on-chain energy. Funds come from the payer's GasFree custodial wallet (not the
# main wallet), which must be activated and funded with USDT on Nile.

# Signing key — client + facilitator.
AGENT_WALLET_PRIVATE_KEY=0x...

# Resource-server payout address (TRON only).
TRON_ADDRESS=T...   # TRON, tron:nile

# Optional TronGrid API key.
TRON_GRID_API_KEY=

# App wiring — facilitator 4032, server 4031 (own ports, never clash with exact).
FACILITATOR_PORT=4032
SERVER_PORT=4031
FACILITATOR_URL=http://localhost:4032
RESOURCE_URL=http://localhost:4031/weather

# Optional: override the GasFree relayer API (defaults to the built-in Nile relayer).
# GASFREE_API_URL=
