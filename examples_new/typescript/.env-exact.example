# ── Scenario: main line (scheme `exact`) ──────────────────────────────────
# Copy to `.env-exact` (gitignored); the exact trio loads it:
#   clients/fetch · servers/express · facilitator/basic
#
#   cp .env-exact.example .env-exact

# Signing key — one key for client + facilitator, both chains.
AGENT_WALLET_PRIVATE_KEY=0x...

# Resource-server payout addresses (set the chain(s) you want to accept).
EVM_ADDRESS=0x...   # BSC, eip155:97
TRON_ADDRESS=T...   # TRON, tron:nile

# Optional TronGrid API key.
TRON_GRID_API_KEY=

# clients/fetch — which chains/tokens to pay, one payment per entry, in order.
#   <network>[@<token>]  network: "eip155:97"/"tron:nile" (or "eip155"/"tron");
#   token: symbol (DHLU/USDC on EVM, USDT/USDD on TRON) or an asset address;
#   omit the token to use that network's first advertised token.
#   Use `@` (not `#`) — dotenv treats `#` as a comment and would truncate the value.
# Unset ⇒ each configured chain once, with its first token.
PAY_TARGETS=eip155:97@DHLU,tron:nile@USDT

# App wiring — facilitator 4022, server 4021.
FACILITATOR_PORT=4022
SERVER_PORT=4021
FACILITATOR_URL=http://localhost:4022
RESOURCE_URL=http://localhost:4021/weather

# MCP example (servers/mcp · clients/mcp) — optional, defaults shown.
MCP_SERVER_PORT=4023
MCP_SERVER_URL=http://localhost:4023
