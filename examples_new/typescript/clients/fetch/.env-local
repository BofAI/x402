# Key custody is handled by @bankofai/agent-wallet — this example never reads a
# raw key. Fill the chain(s) you want enabled; the other self-skips.

# EVM wallet (agent-wallet, network "evm"):
AGENT_WALLET_PRIVATE_KEY=

# TRON wallet (agent-wallet, network "tron"):
TRON_PRIVATE_KEY=

# TRON RPC API key (optional; raises rate limits). EVM RPC is the chain default
# set in src/chains/evm.ts (EVM_NETWORKS) — no env needed.
TRON_GRID_API_KEY=

# Protected resource to pay for:
RESOURCE_URL=http://localhost:4021/weather
